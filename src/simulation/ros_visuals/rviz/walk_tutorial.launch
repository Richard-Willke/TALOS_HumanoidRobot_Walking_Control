<launch>
    <!-- Strategy Mode -->
    <arg name="strategy_mode" default="both" />

    <!-- URDF -->
    <param name="robot_description" command="cat $(find talos_description)/robots/talos_reduced_no_hands.urdf" />

    <!-- Robot_State_Publisher -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
        <param name="publish_frequency" value="30.0" />
    </node>

    <!-- rviz -->
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find ros_visuals)/rviz/walk_tutorial.rviz" required="true" />

    <!-- Python Script -->
    <!-- <node name="control_main" pkg="control_main" type="walk_tutorial.py" output="screen" >
        <param name="strategy_mode" value="$(arg strategy_mode)" />
    </node> -->

</launch>
